{
  "manifest_version": 3,
  "name": "OmniAnalyst - AI Data Analyst Companion",
  "version": "2.1.0",
  "description": "Extract tables from any tab and run deterministic, SQL-verified analysis on Amazon Bedrock. Charts render locally; no remote code.",
  "minimum_chrome_version": "116",
  "permissions": [
    "activeTab",
    "scripting",
    "sidePanel",
    "storage"
  ],
  "host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "side_panel": {
    "default_path": "sidepanel/index.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Open OmniAnalyst Sidepanel"
  }
}
