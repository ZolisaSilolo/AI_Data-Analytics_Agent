# Local development configuration.
#
# Lambda environment variables are NOT read from this file: they are set by
# template.yaml at deploy time. This file is for the helper scripts in
# scripts/ and for running the backend locally.

# --- AWS credentials --------------------------------------------------------
# Prefer `aws configure` or `aws sso login` over putting keys in this file.
# Bedrock model access in this project was verified in us-east-1.
AWS_REGION=us-east-1

# Optional: use a named profile instead of static keys.
# AWS_PROFILE=default

# --- Bedrock ----------------------------------------------------------------
# Must be an inference profile or model id enabled in your account/region.
# Verify with: python scripts/verify_bedrock_access.py
# Interim primary. Anthropic models need the account's use-case details form;
# switch to global.anthropic.claude-sonnet-4-5-20250929-v1:0 once approved.
BEDROCK_PRIMARY_MODEL=global.moonshotai.kimi-k3
# Leave empty to disable failover. A model the account cannot reach only moves
# the failure, so failover is off unless a second model is verified.
BEDROCK_FALLBACK_MODEL=

# --- Deployed resource names (fill in from `sam deploy` outputs) ------------
# DATA_BUCKET=my-stack-lakehouse-123456789012
# JOBS_TABLE=my-stack-jobs
# ANALYSIS_QUEUE_URL=https://sqs.us-east-1.amazonaws.com/123456789012/my-stack-analysis

# --- Runtime limits (optional overrides) ------------------------------------
MAX_UPLOAD_BYTES=52428800
MAX_QUERY_CHARS=4000
MAX_SQL_CHARS=20000
MAX_PAGE_CONTEXT_BYTES=200000
JOB_TTL_DAYS=90
# Must match AnalysisQueue.RedrivePolicy.maxReceiveCount in template.yaml.
MAX_RECEIVE_COUNT=3
LOG_LEVEL=INFO
